# Supabase backend
SUPABASE_URL=https://jlmenuqcxtiwwjfnoupn.supabase.co

# Server-side secret only. Never commit a real key.
# Prefer a modern Supabase secret key when available; legacy service-role also works.
SUPABASE_SECRET_KEY=
AUTOEDITOR_API_TOKEN=

# Optional legacy name
# SUPABASE_SERVICE_ROLE_KEY=

# API server
HOST=0.0.0.0
PORT=8000

# Local rendering is OFF by default for safety.
# Enable only on a trusted worker and keep all paths inside VIDEO_EDITOR_MEDIA_ROOT.
VIDEO_EDITOR_ALLOW_LOCAL_RENDER=0
VIDEO_EDITOR_MEDIA_ROOT=/data/battlebox

# Existing AutoEditor vision
OPENAI_API_KEY=

# Local/remote worker
AUTOEDITOR_API_BASE_URL=https://autoeditor-api-live-production.up.railway.app
AUTOEDITOR_WORKER_ID=
AUTOEDITOR_WORKER_POLL_SEC=5
AUTOEDITOR_WORKER_TIMEOUT_SEC=60
