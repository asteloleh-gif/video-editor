@@ -0,0 +1,40 @@
+import { v4 as uuid } from "uuid";
+import { ActionExecutor } from "@openreel/core";
+import type { StoryJob } from "../../../types/global";
+import { useProjectStore } from "../../../stores/project-store";
+import { cloneProjectForEdit } from "../../../stores/project/clone-project-for-edit";
+
+export async function addStoryToTimeline(job: StoryJob, blob: Blob): Promise<void> {
+  const store = useProjectStore;
+  const check = () => {
+    if (store.getState().project.id !== job.project_id) throw new Error("Откройте проект, в котором запущена сборка.");
+  };
+  check();
+  if (job.status !== "ready") throw new Error("Видео ещё не готово.");
+  const fileName = `Astel-${job.package_id}-${job.id}.mp4`;
+  let mediaId = store.getState().project.mediaLibrary.items.find(m => m.name === fileName)?.id;
+  if (!mediaId) {
+    const result = await store.getState().importMedia(new File([blob], fileName, {type: "video/mp4"}));
+    check();
+    if (!result.success || !result.actionId) throw new Error("Не удалось импортировать MP4. Сохраните файл и попробуйте снова.");
+    mediaId = result.actionId;
+  }
+  const {project, actionExecutor} = store.getState();
+  if (project.timeline.tracks.some(t => t.clips.some(c => c.mediaId === mediaId))) return;
+  const copy = cloneProjectForEdit(project);
+  const scratch = new ActionExecutor();
+  const trackId = uuid();
+  const startTime = Math.max(0, ...copy.timeline.tracks.flatMap(t => t.clips.map(c => c.startTime + c.duration)));
+  const track = await scratch.execute({type: "track/add", id: uuid(), timestamp: Date.now(), params: {trackType: "video", trackId}}, copy);
+  if (!track.success) throw new Error("Не удалось создать видеодорожку.");
+  const clip = await scratch.execute({type: "clip/add", id: uuid(), timestamp: Date.now(), params: {trackId, mediaId, startTime}}, copy);
+  check();
+  if (store.getState().project !== project) throw new Error("Проект изменился. MP4 сохранён в медиа; добавьте его снова.");
+  if (!clip.success) throw new Error("Не удалось добавить видеоклип.");
+  const history = actionExecutor.getHistory();
+  history.beginGroup("Add Astel assembled video");
+  try {
+    for (const entry of scratch.getHistory().getHistoryEntries()) history.push(entry.action, entry.inverseAction);
+  } finally { history.endGroup(); }
+  store.setState({project: {...copy, modifiedAt: Date.now()}});
+}
