diff --git a/apps/web/src/components/editor/inspector/VoiceboxPanel.tsx b/apps/web/src/components/editor/inspector/VoiceboxPanel.tsx
new file mode 100644
index 0000000..f5369a0
--- /dev/null
+++ b/apps/web/src/components/editor/inspector/VoiceboxPanel.tsx
@@ -0,0 +1,165 @@
+import { useEffect, useRef, useState } from "react";
+import type { VoiceboxJob, VoiceboxProfile, VoiceboxRequest } from "../../../types/global";
+import { useProjectStore } from "../../../stores/project-store";
+import { addVoiceboxToTimeline } from "./voicebox-timeline";
+
+const KEY = "astel.voicebox.v1";
+const finished = (job: VoiceboxJob) => ["ready", "failed", "cancelled"].includes(job.status);
+const labels: Record<VoiceboxJob["status"], string> = {
+  queued: "В очереди…", starting: "Запускаю Voicebox…", generating: "Генерирую голос…",
+  processing: "Настраиваю темп и звук…", cancelling: "Останавливаю…", ready: "Озвучка готова",
+  failed: "Не удалось завершить озвучку", cancelled: "Генерация остановлена",
+};
+const control = "w-full rounded border border-border bg-panel p-2 text-fg";
+const button = "rounded border border-border px-3 py-2 text-xs disabled:opacity-40 hover:bg-white/10";
+function saved(): Partial<VoiceboxRequest> & { request?: VoiceboxRequest } {
+  try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; }
+}
+
+export function VoiceboxPanel() {
+  const api = window.openreel?.voicebox;
+  const projectId = useProjectStore(s => s.project.id);
+  const [initial] = useState(saved);
+  const [text, setText] = useState(initial.text || "");
+  const [profile, setProfile] = useState(initial.profile || "oleh-ru");
+  const [speed, setSpeed] = useState(initial.speed || 1);
+  const [warm, setWarm] = useState(initial.warm ?? true);
+  const [profiles, setProfiles] = useState<VoiceboxProfile[]>([]);
+  const [pending, setPending] = useState<VoiceboxRequest | undefined>(initial.request);
+  const [job, setJob] = useState<VoiceboxJob | null>(null);
+  const [jobId, setJobId] = useState(initial.id || "");
+  const [error, setError] = useState("");
+  const [message, setMessage] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [adding, setAdding] = useState(false);
+  const [audio, setAudio] = useState<{ id: string; blob: Blob; url: string } | null>(null);
+  const alive = useRef(true);
+  const submittingRef = useRef(false);
+  const active = submitting || Boolean(job && !finished(job));
+
+  useEffect(() => { alive.current = true; return () => { alive.current = false; }; }, []);
+  useEffect(() => {
+    let cancelled = false;
+    api?.profiles().then(p => { if (!cancelled) setProfiles(p); }).catch(() => {
+      if (!cancelled) setError("Не найдены локальные голоса. Проверьте установку Voicebox.");
+    });
+    return () => { cancelled = true; };
+  }, [api]);
+  useEffect(() => {
+    localStorage.setItem(KEY, JSON.stringify({ id: jobId, text, profile, speed, warm, request: pending }));
+  }, [jobId, text, profile, speed, warm, pending]);
+
+  useEffect(() => {
+    if (!api || !jobId) return;
+    let cancelled = false;
+    let timer: ReturnType<typeof setTimeout>;
+    const poll = async (resume: boolean) => {
+      try {
+        const next = await (resume ? api.resume(jobId) : api.status(jobId));
+        if (cancelled) return;
+        setJob(next);
+        setError("");
+        if (!finished(next)) timer = setTimeout(() => void poll(false), 1500);
+      } catch {
+        if (!cancelled) {
+          setError("Не удалось проверить озвучку. Задание сохранено; проверю ещё раз.");
+          timer = setTimeout(() => void poll(false), 5000);
+        }
+      }
+    };
+    void poll(true);
+    return () => { cancelled = true; clearTimeout(timer); };
+  }, [api, jobId]);
+
+  useEffect(() => {
+    if (!api || job?.status !== "ready") { setAudio(null); return; }
+    let cancelled = false;
+    let url: string | undefined;
+    api.audio(job.id).then(bytes => {
+      if (cancelled) return;
+      const blob = new Blob([bytes], { type: "audio/wav" });
+      url = URL.createObjectURL(blob);
+      setAudio({ id: job.id, blob, url });
+    }).catch(() => { if (!cancelled) setError("Не удалось открыть WAV. Файл сохранён в Voicebox."); });
+    return () => { cancelled = true; if (url) URL.revokeObjectURL(url); };
+  }, [api, job?.id, job?.status]);
+
+  async function generate() {
+    if (!api || submittingRef.current || active || !text.trim()) return;
+    submittingRef.current = true;
+    setSubmitting(true); setError(""); setMessage("");
+    const request = { id: crypto.randomUUID(), profile, text: text.trim(), speed, warm: profile === "oleh-ru" && warm, project_id: projectId };
+    // Save the ID before IPC. Reopening checks this same job and never re-submits it.
+    localStorage.setItem(KEY, JSON.stringify({ ...request, request }));
+    setPending(request); setJob(null); setJobId(request.id);
+    try {
+      const next = await api.submit(request);
+      if (alive.current) { setJob(next); setJobId(next.id); }
+    } catch {
+      if (alive.current) {
+        setJobId(request.id);
+        setError("Не удалось получить ответ. Проверяю сохранённое задание.");
+      }
+    } finally {
+      submittingRef.current = false;
+      if (alive.current) setSubmitting(false);
+    }
+  }
+  async function add() {
+    if (!audio || !job || adding) return;
+    setAdding(true); setError("");
+    try {
+      await addVoiceboxToTimeline(job, audio.blob);
+      if (alive.current) setMessage("Добавлено на новую аудиодорожку в конец таймлайна.");
+    } catch (e) {
+      if (alive.current) setError(e instanceof Error ? e.message : "Не удалось добавить озвучку.");
+    } finally { if (alive.current) setAdding(false); }
+  }
+  const restoring = Boolean(jobId && !job);
+  const readyAudio = audio && audio.id === job?.id ? audio : null;
+  return <section aria-label="Voicebox" className="space-y-3 text-xs text-fg">
+    <div className="rounded border border-primary/30 p-3">
+      <strong>Voicebox · голос Олега</strong>
+      <p className="mt-1 text-fg-3">На этом Mac. Результат сохранится автоматически.</p>
+    </div>
+    {!api && <p role="alert">Откройте OpenReel Astel для локальной озвучки.</p>}
+    <label className="block">Голос
+      <select aria-label="Голос" className={control} value={profile} disabled={active || restoring} onChange={e => {
+        const p = profiles.find(p => p.id === e.target.value);
+        if (p) { setProfile(p.id); setSpeed(p.speed); setWarm(p.warm); }
+      }}>
+        {profiles.length ? profiles.map(p => <option key={p.id} value={p.id}>{p.name}</option>) : <option value={profile}>Загрузка голосов…</option>}
+      </select>
+    </label>
+    <label className="block">Текст для озвучки
+      <textarea aria-label="Текст для озвучки" className={`${control} mt-1 resize-y`} rows={4} value={text} maxLength={5000} disabled={active || restoring} placeholder="Вставьте текст на выбранном языке…" onChange={e => setText(e.target.value)} />
+    </label>
+    <div className="flex items-center justify-between gap-2">
+      <label>Темп <select aria-label="Темп" className="rounded border border-border bg-panel p-1" value={speed} disabled={active || restoring} onChange={e => setSpeed(Number(e.target.value))}>
+        {[0.85, 0.95, 1, 1.02, 1.1, 1.2, 1.3, 1.5].map(n => <option key={n} value={n}>{Math.round(n * 100)}%</option>)}
+      </select></label><span className="text-fg-3">{text.length}/5000</span>
+    </div>
+    {profile === "oleh-ru" && <label className="flex items-center gap-2"><input type="checkbox" checked={warm} disabled={active || restoring} onChange={e => setWarm(e.target.checked)} />Тёплый звук B</label>}
+    <button className={`${button} w-full bg-primary/20`} disabled={!api || !profiles.length || !text.trim() || active || restoring || adding} onClick={() => void generate()}>{active ? "Озвучиваю…" : "Озвучить"}</button>
+    {(active || restoring) && <p className="text-fg-3">Первый запуск загружает модель. Генерация может занять несколько минут.</p>}
+    {job && <div role="status" aria-live="polite" className="space-y-2 rounded border border-border p-2">
+      <p>{labels[job.status]}{job.duration ? ` · ${job.duration.toFixed(1)} с` : ""}</p>
+      {!finished(job) && <button className={button} disabled={job.status === "cancelling"} onClick={() => void api?.cancel(job.id).then(setJob).catch(() => setError("Не удалось остановить задание. Повторите попытку."))}>Остановить</button>}
+      {job.error && <p>{job.error}</p>}
+    </div>}
+    {readyAudio && <div className="space-y-2">
+      <audio aria-label="Прослушать озвучку" controls src={readyAudio.url} className="w-full" />
+      <a className={`${button} inline-block`} href={readyAudio.url} download={`Oleh-${job!.profile}-${job!.id.slice(0, 8)}.wav`}>Скачать WAV</a>
+      <button className={`${button} w-full`} disabled={adding || job?.project_id !== projectId} onClick={() => void add()}>{adding ? "Добавляю…" : "Добавить на таймлайн"}</button>
+      {job?.project_id !== projectId && <p>Вернитесь в проект, в котором создана эта озвучка, чтобы добавить её на таймлайн.</p>}
+    </div>}
+    {error && <p role="alert" className="text-red-400">{error}</p>}
+    {error && restoring && pending && <button className={button} disabled={submitting} onClick={() => {
+      setSubmitting(true);
+      void api?.submit(pending).then(next => { if (alive.current) { setJob(next); setError(""); } }).catch(() => {
+        if (alive.current) setError("Voicebox пока недоступен. Проверьте локальную установку.");
+      }).finally(() => { if (alive.current) setSubmitting(false); });
+    }}>Повторить подключение</button>}
+    {message && <p role="status" className="text-green-400">{message}</p>}
+  </section>;
+}
diff --git a/apps/web/src/components/editor/inspector/story-timeline.test.ts b/apps/web/src/components/editor/inspector/story-timeline.test.ts
