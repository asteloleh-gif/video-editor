+    expect(mock.scratch.execute).toHaveBeenNthCalledWith(2, expect.objectContaining({ type: "clip/add", params: expect.objectContaining({ mediaId: "media-1", startTime: 7 }) }), expect.anything());
+    expect(mock.set).toHaveBeenCalledOnce();
+  });
+  it("refuses a wrong project before importing", async () => {
+    mock.state.project.id = "b";
+    await expect(addVoiceboxToTimeline(job, new Blob())).rejects.toThrow("Откройте проект");
+    expect(mock.state.importMedia).not.toHaveBeenCalled();
+  });
+  it("refuses a project switch during decoding", async () => {
+    mock.state.importMedia.mockImplementation(async () => {
+      mock.state.project = { ...mock.state.project, id: "b" };
+      return { success: true, actionId: "media-1" };
+    });
+    await expect(addVoiceboxToTimeline(job, new Blob())).rejects.toThrow("Откройте проект");
+    expect(mock.scratch.execute).not.toHaveBeenCalled();
+    expect(mock.set).not.toHaveBeenCalled();
+    expect(mock.state.actionExecutor.getHistory).not.toHaveBeenCalled();
+  });
+  it("refuses to overwrite manual edits made during track creation", async () => {
+    mock.scratch.execute.mockImplementation(async () => {
+      mock.state.project = { ...mock.state.project, modifiedAt: 123 };
+      return { success: true };
+    });
+    await expect(addVoiceboxToTimeline(job, new Blob())).rejects.toThrow("Проект изменился");
+    expect(mock.set).not.toHaveBeenCalled();
+    expect(mock.state.actionExecutor.getHistory).not.toHaveBeenCalled();
+  });
+  it("reuses the same imported media on another add", async () => {
+    mock.state.project.mediaLibrary.items = [{ id: "media-existing", name: "Voicebox-oleh-ru-job-1.wav" }];
+    await addVoiceboxToTimeline(job, new Blob());
+    expect(mock.state.importMedia).not.toHaveBeenCalled();
+  });
+});
