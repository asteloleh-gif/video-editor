+import React, {useEffect, useRef, useState} from "react";
+import type {WorkspaceAsset, WorkspaceSnapshot, WorkspaceSubmit, WorkspaceStory} from "../../../types/global";
+import {useProjectStore} from "../../../stores/project-store";
+import {addStoryToTimeline} from "./story-timeline";
+
+const initial: WorkspaceSnapshot = {jobs: [], searches: [], assets: [], stories: [], reviews: [], disk_free_bytes: 0, publishing_enabled: false};
+const control = "w-full bg-background-secondary border border-border rounded p-2 text-sm";
+const button = "rounded border border-border px-3 py-2 text-xs hover:bg-background-secondary disabled:opacity-40";
+const pendingKey = "astel-workspace-pending-v1";
+const draftKey = "astel-workspace-draft-v1";
+const readDraft = (): {query?: string; topics?: string; title?: string; script?: string; profile?: "oleh-ru" | "oleh-en"; selected?: string[]} => {
+  try {
+    const value = JSON.parse(localStorage.getItem(draftKey) || "{}");
+    if (!value || typeof value !== "object" || Array.isArray(value)) return {};
+    const text = (key: string, limit: number) => typeof value[key] === "string" ? value[key].slice(0, limit) : "";
+    return {query: text("query", 200), topics: text("topics", 20100), title: text("title", 160), script: text("script", 3000),
+      profile: value.profile === "oleh-en" ? "oleh-en" : "oleh-ru", selected: Array.isArray(value.selected) ? value.selected.filter((id: unknown) => typeof id === "string").slice(0, 12) : []};
+  } catch {return {};}
+};
+export const MediaWorkspacePanel: React.FC = () => {
+  const api = window.openreel?.mediaWorkspace;
+  const projectId = useProjectStore(s => s.project.id);
+  const [draft] = useState(readDraft);
+  const [activeSearch, setActiveSearch] = useState<string | null>(null);
+  const [parent, setParent] = useState<WorkspaceStory | null>(null);
+  const [snapshot, setSnapshot] = useState(initial);
+  const [tab, setTab] = useState("library");
+  const [query, setQuery] = useState(draft.query || "");
+  const [topics, setTopics] = useState(draft.topics || "");
+  const [provider, setProvider] = useState("commons");
+  const [title, setTitle] = useState(draft.title || "");
+  const [script, setScript] = useState(draft.script || "");
+  const [profile, setProfile] = useState<"oleh-ru" | "oleh-en">(draft.profile === "oleh-en" ? "oleh-en" : "oleh-ru");
+  const [selected, setSelected] = useState<string[]>(Array.isArray(draft.selected) ? draft.selected.filter(id => typeof id === "string").slice(0, 12) : []);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [story, setStory] = useState<WorkspaceStory | null>(null);
+  const [blob, setBlob] = useState<Blob | null>(null);
+  const [url, setUrl] = useState("");
+  const submitting = useRef(false);
+  useEffect(() => {
+    try {localStorage.setItem(draftKey, JSON.stringify({query, topics, title, script, profile, selected}));} catch {setError("Черновик не сохранился локально.");}
+  }, [query, topics, title, script, profile, selected]);
+  useEffect(() => {
+    if (!api) return;
+    let active = true; let timer: ReturnType<typeof setTimeout>;
+    const refresh = async () => {
+      try {
+        const data = await api.list(); if (!active) return;
+        setSnapshot(data);
+        const running = data.jobs.filter(job => !["ready", "failed", "cancelled"].includes(job.status));
+        await Promise.all(running.map(job => api.resume(job.id)));
+        if (active) timer = setTimeout(refresh, running.length ? 1800 : 7000);
+      } catch {if (active) {setError("Связь с библиотекой прервана. Повторяем проверку."); timer = setTimeout(refresh, 5000);}}
+    };
+    void refresh();
+    return () => {active = false; clearTimeout(timer);};
+  }, [api]);
+  useEffect(() => {
+    setBlob(null);
+    if (!api || !story) {setBlob(null); return;}
+    let active = true;
+    api.video(story.id).then(bytes => {if (active) setBlob(new Blob([bytes], {type: "video/mp4"}));}).catch(() => {if (active) setError("Не удалось открыть готовый файл.");});
+    return () => {active = false;};
+  }, [api, story]);
+  useEffect(() => {
+    if (!blob) {setUrl(""); return;}
+    const value = URL.createObjectURL(blob); setUrl(value);
+    return () => URL.revokeObjectURL(value);
+  }, [blob]);
+  const refresh = async () => {if (api) setSnapshot(await api.list());};
+  const run = async (kind: WorkspaceSubmit["kind"], payload: WorkspaceSubmit["payload"]) => {
+    if (!api || submitting.current) return;
+    submitting.current = true; setBusy(true); setError("");
+    try {
+      const pending = localStorage.getItem(pendingKey);
+      const request: WorkspaceSubmit = pending ? JSON.parse(pending) : {id: crypto.randomUUID(), kind, payload};
+      localStorage.setItem(pendingKey, JSON.stringify(request));
+      await api.submit(request); localStorage.removeItem(pendingKey); await refresh();
+    } catch (e) {
+      const message = e instanceof Error ? e.message : "Не удалось запустить задачу.";
+      if (message.includes("INPUT_REJECTED")) localStorage.removeItem(pendingKey);
+      setError(message);
+    } finally {submitting.current = false; setBusy(false);}
+  };
+  const importLocal = async () => {
+    if (!api) return; setBusy(true); setError("");
+    try {await api.importLocal(); await refresh();} catch {setError("Не удалось получить выбранный файл.");} finally {setBusy(false);}
+  };
+  const addAsset = async (asset: WorkspaceAsset) => {
+    if (!api) return; const expected = projectId; setBusy(true); setError("");
+    try {
+      const bytes = await api.file(asset.id);
+      if (useProjectStore.getState().project.id !== expected) throw new Error("Проект изменился; выберите его заново.");
+      const name = `Astel-${asset.id}.${asset.kind === "video" ? "mp4" : "jpg"}`;
+      if (!useProjectStore.getState().project.mediaLibrary.items.some(item => item.name === name)) {
+        const result = await useProjectStore.getState().importMedia(new File([bytes], name, {type: asset.kind === "video" ? "video/mp4" : "image/jpeg"}));
+        if (!result.success) throw new Error("Импорт не завершён.");
+      }
+    } catch (e) {setError(e instanceof Error ? e.message : "Ошибка импорта.");} finally {setBusy(false);}
+  };
+  const addStory = async () => {
+    if (!story || !blob) return; setBusy(true); setError("");
+    try {
+      await addStoryToTimeline({id: story.id, project_id: story.project_id, package_id: "story-v1", revision: String(story.revision), status: "ready", progress: 1, created_at: story.created_at, updated_at: story.created_at}, blob);
+    } catch (e) {setError(e instanceof Error ? e.message : "Ошибка импорта ролика.");} finally {setBusy(false);}
+  };
+  const exportCard = async () => {
+    if (!api || !story || !window.openreel) return;
+    setBusy(true); setError("");
+    try {
+      const card = await api.card(story.id);
+      const destination = await window.openreel.fs.showSaveDialog({defaultPath: `Astel-review-${story.id}.json`, filters: [{name: "Canvas review card", extensions: ["json"]}]});
+      if (destination) await window.openreel.fs.writeFile(destination, JSON.stringify(card, null, 2));
+    } catch {setError("Не удалось сохранить карточку согласования.");} finally {setBusy(false);}
+  };
+  const save = async () => {
+    if (!blob || !story || !window.openreel) return;
+    setBusy(true); setError("");
+    try {
+      const destination = await window.openreel.fs.showSaveDialog({defaultPath: `Astel-story-${story.id}.mp4`, filters: [{name: "MP4", extensions: ["mp4"]}]});
+      if (destination) {
+        const handle = await window.openreel.fs.openWrite(destination);
+        try {for (let offset = 0; offset < blob.size; offset += 4 * 1024 * 1024) await window.openreel.fs.writeChunk(handle, await blob.slice(offset, offset + 4 * 1024 * 1024).arrayBuffer(), offset); await window.openreel.fs.closeWrite(handle);}
+        catch (e) {await window.openreel.fs.abortWrite(handle); throw e;}
+      }
+    } catch {setError("Не удалось сохранить MP4.");} finally {setBusy(false);}
+  };
+  if (!api) return <p>Библиотека доступна в OpenReel Astel на Mac.</p>;
+  const latest = snapshot.searches.find(item => item.id === activeSearch) ?? snapshot.searches[0];
+  return <section className="space-y-4 text-sm" aria-label="Материалы и истории">
+    <h3 className="font-bold">Материалы и истории</h3>
+    <div className="flex flex-wrap gap-1">{[["library", "Библиотека"], ["story", "Новая история"], ["batch", "Темы"], ["review", "Для Canvas"]].map(([id, label]) => <button key={id} className={button} aria-pressed={tab === id} onClick={() => setTab(id)}>{label}</button>)}</div>
+    {tab === "library" && <div className="space-y-3">
+      <label className="block">Тема<input aria-label="Тема материалов" className={control} value={query} onChange={e => setQuery(e.target.value)} maxLength={200} /></label>
+      <label className="block">Источник<select aria-label="Источник материалов" className={control} value={provider} onChange={e => setProvider(e.target.value)}><option value="commons">Commons · файлы</option><option value="youtube">YouTube · референсы</option><option value="both">Оба источника</option></select></label>
+      <button className={button} disabled={busy || !query.trim()} onClick={() => {setActiveSearch(null); void run("search", {query, providers: provider === "both" ? ["commons", "youtube"] : [provider]});}}>Найти материал</button>
+      <button className={button} disabled={busy} onClick={() => void importLocal()}>Добавить свой файл…</button>
+      {latest && <div className="space-y-2"><p>Результаты: {latest.query}</p>{latest.errors.map((item, i) => <p key={i} className="text-xs text-amber-400">{item.provider}: {item.message}</p>)}{latest.candidates.map(item => <article key={item.id} className="border border-border rounded p-2 space-y-1">
+        <p className="font-medium">{item.title}</p><p className="text-xs text-text-secondary">{item.provider} · {item.author} · {item.license || "Референс"}</p>
+        <a href={item.url ?? undefined} target="_blank" rel="noreferrer" className="text-primary text-xs">Открыть источник</a>
+        <button className={button} disabled={busy || !item.downloadable} onClick={() => void run("acquire", {candidate_id: item.id})}>{item.downloadable ? "Получить файл" : "Ссылка-референс"}</button>
+      </article>)}</div>}
+      <p className="font-semibold">Сохранённые файлы · {snapshot.assets.length}</p>
+      {snapshot.assets.map(asset => <article className="border border-border rounded p-2 space-y-1" key={asset.id}>
+        <label className="flex gap-2"><input type="checkbox" checked={selected.includes(asset.id)} onChange={e => setSelected(items => e.target.checked ? [...items, asset.id].slice(0, 12) : items.filter(id => id !== asset.id))} />{asset.title}</label>
+        <p className="text-xs text-text-secondary">{asset.kind} · {asset.width}×{asset.height} · {asset.license}</p>
+        <button className={button} disabled={busy} onClick={() => void addAsset(asset)}>Добавить в медиа проекта</button>
+      </article>)}
+      <p className="text-xs text-text-secondary">Выберите файлы для новой истории. Оригиналы сохраняются отдельно от подготовленных копий. Свободно: {(snapshot.disk_free_bytes / 1024 ** 3).toFixed(1)} GiB.</p>
+    </div>}
+    {tab === "story" && <div className="space-y-3">
+      {parent && <button className={button} onClick={() => setParent(null)}>Начать отдельную историю</button>}
+      <label className="block">Название<input aria-label="Название истории" className={control} value={title} onChange={e => setTitle(e.target.value)} maxLength={160} /></label>
