+import { spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFile, realpath, stat } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { z } from "zod";
+import { handle } from "./index";
+import { CHANNELS, voiceboxJobSchema, storySubmitSchema } from "../../shared/ipc-contract";
+
+const home = path.join(os.homedir(), ".local/share/astel-story-render");
+const message = "Сборка недоступна. Проверьте локальную установку пакета.";
+export function runStory(command: string, id?: string, request?: unknown): Promise<unknown> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(path.join(home, "venv/bin/python"), ["-m", "video_editor.story_jobs", command, ...(id ? ["--id", id] : [])], {
+      env: { ...process.env, ASTEL_STORY_HOME: home, PYTHONPATH: path.join(home, "src") },
+      stdio: ["pipe", "pipe", "pipe"], windowsHide: true,
+    });
+    let output = "";
+    const timer = setTimeout(() => { child.kill(); reject(new Error(message)); }, 30_000);
+    child.stdout.on("data", (data: Buffer) => {
+      output += data.toString();
+      if (output.length > 100_000) { child.kill(); reject(new Error(message)); }
+    });
+    child.stderr.resume();
+    child.on("error", () => { clearTimeout(timer); reject(new Error(message)); });
+    child.on("close", code => {
+      clearTimeout(timer);
+      if (code !== 0) return reject(new Error(message));
+      try { resolve(JSON.parse(output)); } catch { reject(new Error(message)); }
+    });
+    child.stdin.on("error", () => {});
+    child.stdin.end(request === undefined ? "" : JSON.stringify(request));
+  });
+}
+
+export async function readStoryVideo(id: string): Promise<ArrayBuffer> {
+  const receipt = await runStory("video", id) as {path: string; sha256: string};
+  const expected = path.join(home, "jobs", id, "video.mp4");
+  if (receipt.path !== expected || await realpath(expected) !== expected || (await stat(expected)).size > 300 * 1024 * 1024) throw new Error(message);
+  const data = await readFile(expected);
+  if (createHash("sha256").update(data).digest("hex") !== receipt.sha256) throw new Error("MP4 изменился.");
+  return data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength) as ArrayBuffer;
+}
+
+export function registerStoryHandlers(): void {
+  handle(CHANNELS.storyPackages, z.undefined(), () => runStory("packages"));
+  handle(CHANNELS.storyRecent, z.undefined(), () => runStory("recent"));
+  handle(CHANNELS.storySubmit, storySubmitSchema, request => runStory("submit", undefined, request));
+  handle(CHANNELS.storyResume, voiceboxJobSchema, ({id}) => runStory("resume", id));
+  handle(CHANNELS.storyCancel, voiceboxJobSchema, ({id}) => runStory("cancel", id));
+  handle(CHANNELS.storyVideo, voiceboxJobSchema, ({id}) => readStoryVideo(id));
+}
