@@ -0,0 +1,61 @@
+import { spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFile, realpath, stat } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { z } from "zod";
+import { handle } from "./index";
+import { CHANNELS, voiceboxJobSchema, voiceboxSubmitSchema } from "../../shared/ipc-contract";
+
+const home = path.join(os.homedir(), ".local", "share", "astel-voicebox");
+const root = path.join(home, "openreel");
+const python = path.join(home, "venv", "bin", "python");
+const message = "Voicebox недоступен. Проверьте локальную установку и попробуйте снова.";
+
+// Fixed executable and arguments; narration is JSON on stdin, never shell code.
+export function runVoicebox(command: string, id?: string, request?: unknown): Promise<unknown> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(python, ["-m", "video_editor.voicebox_jobs", command, ...(id ? ["--id", id] : [])], {
+      env: { ...process.env, ASTEL_VOICEBOX_HOME: home, PYTHONPATH: path.join(root, "src") },
+      stdio: ["pipe", "pipe", "pipe"],
+      windowsHide: true,
+    });
+    let output = "";
+    const timer = setTimeout(() => { child.kill(); reject(new Error(message)); }, 40_000);
+    child.stdout.on("data", (data: Buffer) => {
+      output += data.toString();
+      if (output.length > 100_000) { child.kill(); reject(new Error(message)); }
+    });
+    // Keep private reference paths/diagnostics out of renderer and crash reports.
+    child.stderr.resume();
+    child.on("error", () => { clearTimeout(timer); reject(new Error(message)); });
+    child.on("close", code => {
+      clearTimeout(timer);
+      if (code !== 0) return reject(new Error(message));
+      try { resolve(JSON.parse(output)); } catch { reject(new Error(message)); }
+    });
+    child.stdin.on("error", () => {});
+    child.stdin.end(request === undefined ? "" : JSON.stringify(request));
+  });
+}
+
+export async function readVoiceboxAudio(id: string): Promise<ArrayBuffer> {
+  const result = await runVoicebox("audio", id) as { path: string; sha256: string };
+  const expected = path.join(root, "jobs", id, "narration.wav");
+  // Both the Python receipt and the real filesystem location must agree.
+  if (result.path !== expected || await realpath(expected) !== expected || (await stat(expected)).size > 100 * 1024 * 1024) {
+    throw new Error("Озвучка недоступна.");
+  }
+  const data = await readFile(expected);
+  if (createHash("sha256").update(data).digest("hex") !== result.sha256) throw new Error("Озвучка изменилась.");
+  return data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength) as ArrayBuffer;
+}
+
+export function registerVoiceboxHandlers(): void {
+  handle(CHANNELS.voiceboxProfiles, z.undefined(), () => runVoicebox("profiles"));
+  handle(CHANNELS.voiceboxSubmit, voiceboxSubmitSchema, request => runVoicebox("submit", undefined, request));
+  handle(CHANNELS.voiceboxStatus, voiceboxJobSchema, ({ id }) => runVoicebox("status", id));
+  handle(CHANNELS.voiceboxResume, voiceboxJobSchema, ({ id }) => runVoicebox("resume", id));
+  handle(CHANNELS.voiceboxCancel, voiceboxJobSchema, ({ id }) => runVoicebox("cancel", id));
+  handle(CHANNELS.voiceboxAudio, voiceboxJobSchema, ({ id }) => readVoiceboxAudio(id));
+}
