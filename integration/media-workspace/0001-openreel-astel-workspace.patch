@@ -0,0 +1,55 @@
+import {spawn} from "node:child_process";
+import {createHash} from "node:crypto";
+import {readFile, realpath, stat} from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import {z} from "zod";
+import {shell} from "electron";
+import {handle} from "./index";
+import {showOpenDialog} from "./fs";
+import {CHANNELS, voiceboxJobSchema, workspaceSubmitSchema} from "../../shared/ipc-contract";
+
+const home = path.join(os.homedir(), ".local/share/astel-media-workspace");
+const message = "Библиотека недоступна. Задания сохранены; повторите проверку.";
+export function runWorkspace(command: string, id?: string, request?: unknown): Promise<unknown> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(path.join(home, "venv/bin/python"), ["-m", "video_editor.media_workspace", command, ...(id ? ["--id", id] : [])], {
+      env: {...process.env, ASTEL_MEDIA_HOME: home, PYTHONPATH: path.join(home, "src"), PATH: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
+      stdio: ["pipe", "pipe", "pipe"], windowsHide: true,
+    });
+    let output = "";
+    const timer = setTimeout(() => {child.kill(); reject(new Error(message));}, 30_000);
+    child.stdout.on("data", (data: Buffer) => {output += data.toString(); if (output.length > 3_000_000) {child.kill(); reject(new Error(message));}});
+    child.stderr.resume();
+    child.on("error", () => {clearTimeout(timer); reject(new Error(message));});
+    child.on("close", code => {
+      clearTimeout(timer);
+      if (code !== 0) return reject(new Error(message));
+      try {const value = JSON.parse(output); if (value.error) reject(new Error(`INPUT_REJECTED: ${value.message}`)); else resolve(value);}
+      catch {reject(new Error(message));}
+    });
+    child.stdin.on("error", () => {}); child.stdin.end(request === undefined ? "" : JSON.stringify(request));
+  });
+}
+export async function readWorkspaceBytes(command: "file" | "video", id: string): Promise<ArrayBuffer> {
+  const result = await runWorkspace(command, id) as {path: string; sha256: string};
+  const root = path.join(home, command === "file" ? "assets" : "jobs", id) + path.sep;
+  if (!result.path.startsWith(root) || await realpath(result.path) !== result.path || (await stat(result.path)).size > 300 * 1024 * 1024) throw new Error(message);
+  const data = await readFile(result.path);
+  if (createHash("sha256").update(data).digest("hex") !== result.sha256) throw new Error("Файл изменился.");
+  return data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength) as ArrayBuffer;
+}
+export function registerWorkspaceHandlers(): void {
+  handle(CHANNELS.workspaceCanvas, z.undefined(), () => shell.openExternal("http://127.0.0.1:17531/"));
+  handle(CHANNELS.workspaceCard, voiceboxJobSchema, ({id}) => runWorkspace("card", id));
+  handle(CHANNELS.workspaceList, z.undefined(), () => runWorkspace("list"));
+  handle(CHANNELS.workspaceSubmit, workspaceSubmitSchema, request => runWorkspace("submit", undefined, request));
+  handle(CHANNELS.workspaceResume, voiceboxJobSchema, ({id}) => runWorkspace("resume", id));
+  handle(CHANNELS.workspaceCancel, voiceboxJobSchema, ({id}) => runWorkspace("cancel", id));
+  handle(CHANNELS.workspaceFile, voiceboxJobSchema, ({id}) => readWorkspaceBytes("file", id));
+  handle(CHANNELS.workspaceVideo, voiceboxJobSchema, ({id}) => readWorkspaceBytes("video", id));
+  handle(CHANNELS.workspaceImport, z.undefined(), async () => {
+    const selected = await showOpenDialog({filters: [{name: "Видео и изображения", extensions: ["mp4", "mov", "webm", "m4v", "jpg", "jpeg", "png", "webp"]}]});
+    return selected ? runWorkspace("import", undefined, {path: selected}) : null;
+  });
+}
