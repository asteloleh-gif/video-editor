+import { v4 as uuid } from "uuid";
+import { ActionExecutor } from "@openreel/core";
+import type { VoiceboxJob } from "../../../types/global";
+import { useProjectStore } from "../../../stores/project-store";
+import { cloneProjectForEdit } from "../../../stores/project/clone-project-for-edit";
+
+export async function addVoiceboxToTimeline(job: VoiceboxJob, blob: Blob): Promise<void> {
+  const store = useProjectStore;
+  const check = () => {
+    if (store.getState().project.id !== job.project_id) throw new Error("Откройте проект, в котором была создана озвучка.");
+  };
+  check();
+  if (job.status !== "ready") throw new Error("Озвучка ещё не готова.");
+  const fileName = `Voicebox-${job.profile}-${job.id}.wav`;
+  let mediaId = store.getState().project.mediaLibrary.items.find(m => m.name === fileName)?.id;
+  if (!mediaId) {
+    const result = await store.getState().importMedia(new File([blob], fileName, { type: "audio/wav" }));
+    check();
+    if (!result.success || !result.actionId) throw new Error("Не удалось импортировать WAV. Скачайте файл и попробуйте снова.");
+    mediaId = result.actionId;
+  }
+  const { project, actionExecutor } = store.getState();
+  const copy = cloneProjectForEdit(project);
+  const scratch = new ActionExecutor();
+  const trackId = uuid();
+  const startTime = Math.max(0, ...copy.timeline.tracks.flatMap(t => t.clips.map(c => c.startTime + c.duration)));
+  // Work on a copy; refuse to overwrite a project changed during async actions.
+  const track = await scratch.execute({ type: "track/add", id: uuid(), timestamp: Date.now(), params: { trackType: "audio", trackId } }, copy);
+  if (!track.success) throw new Error("Не удалось создать аудиодорожку.");
+  const clip = await scratch.execute({ type: "clip/add", id: uuid(), timestamp: Date.now(), params: { trackId, mediaId, startTime } }, copy);
+  check();
+  if (store.getState().project !== project) throw new Error("Проект изменился. Озвучка сохранена в медиа; нажмите добавить ещё раз.");
+  if (!clip.success) throw new Error("Не удалось добавить аудиоклип.");
+  const history = actionExecutor.getHistory();
+  history.beginGroup("Add Voicebox narration");
+  try {
+    for (const entry of scratch.getHistory().getHistoryEntries()) history.push(entry.action, entry.inverseAction);
+  } finally { history.endGroup(); }
+  store.setState({ project: { ...copy, modifiedAt: Date.now() } });
+}
