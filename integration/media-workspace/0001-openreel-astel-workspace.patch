diff --git a/apps/web/src/components/editor/inspector/StoryAssemblyPanel.tsx b/apps/web/src/components/editor/inspector/StoryAssemblyPanel.tsx
new file mode 100644
index 0000000..11d684a
--- /dev/null
+++ b/apps/web/src/components/editor/inspector/StoryAssemblyPanel.tsx
@@ -0,0 +1,158 @@
+import React, {useEffect, useRef, useState} from "react";
+import {ToolcraftButton as Button} from "@openreel/ui";
+import type {StoryJob, StoryPackage} from "../../../types/global";
+import {useProjectStore} from "../../../stores/project-store";
+import {addStoryToTimeline} from "./story-timeline";
+
+const pendingKey = "astel-story-pending-v1";
+const terminal = (job: StoryJob) => ["ready", "failed", "cancelled"].includes(job.status);
+type Request = {id: string; package_id: string; project_id: string};
+export const StoryAssemblyPanel: React.FC = () => {
+  const api = window.openreel?.storyRender;
+  const projectId = useProjectStore(s => s.project.id);
+  const [packages, setPackages] = useState<StoryPackage[]>([]);
+  const [packageId, setPackageId] = useState("");
+  const [job, setJob] = useState<StoryJob | null>(null);
+  const [recent, setRecent] = useState<StoryJob[]>([]);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [blob, setBlob] = useState<Blob | null>(null);
+  const [url, setUrl] = useState("");
+  const added = useProjectStore(s => {
+    if (!job) return false;
+    const name = `Astel-${job.package_id}-${job.id}.mp4`;
+    const mediaId = s.project.mediaLibrary.items.find(item => item.name === name)?.id;
+    return !!mediaId && s.project.timeline.tracks.some(track => track.clips.some(clip => clip.mediaId === mediaId));
+  });
+  const submitting = useRef(false);
+
+  useEffect(() => {
+    if (!api) return;
+    let active = true;
+    Promise.all([api.packages(), api.recent()]).then(([list, jobs]) => {
+      if (!active) return;
+      setPackages(list); setPackageId(list[0]?.id ?? ""); setRecent(jobs);
+      const latest = jobs.find(item => item.project_id === projectId);
+      setJob(latest ?? null);
+      const pending = localStorage.getItem(pendingKey);
+      if (pending) {
+        const request = JSON.parse(pending) as Request;
+        if (request.project_id === projectId) {
+          api.submit(request).then(value => {
+            if (!active) return;
+            localStorage.removeItem(pendingKey); setJob(value);
+            setRecent(items => [value, ...items.filter(item => item.id !== value.id)].slice(0, 20));
+          }).catch(() => {if (active) setError("Запуск сохранён. Нажмите «Собрать MP4» для повторной проверки.");});
+        }
+      }
+    }).catch(() => {if (active) setError("Локальная сборка не установлена или недоступна.");});
+    return () => {active = false;};
+  }, [api, projectId]);
+
+  const jobId = job?.id;
+  const isTerminal = job ? terminal(job) : true;
+  useEffect(() => {
+    if (!api || !jobId || isTerminal) return;
+    let active = true;
+    let timer: ReturnType<typeof setTimeout>;
+    const poll = async () => {
+      try {
+        const next = await api.resume(jobId);
+        if (!active) return;
+        setJob(next); setError("");
+        if (!terminal(next)) timer = setTimeout(poll, 2000);
+      } catch {
+        if (active) {setError("Связь прервана. Задача сохранена; повторяем проверку."); timer = setTimeout(poll, 5000);}
+      }
+    };
+    void poll();
+    return () => {active = false; clearTimeout(timer);};
+  }, [api, jobId, isTerminal]);
+
+  const ready = job?.status === "ready";
+  useEffect(() => {
+    setBlob(null);
+    if (!api || !jobId || !ready) return;
+    let active = true;
+    api.video(jobId).then(bytes => {if (active) setBlob(new Blob([bytes], {type: "video/mp4"}));})
+      .catch(() => {if (active) setError("Не удалось открыть MP4. Выберите задачу ещё раз.");});
+    return () => {active = false;};
+  }, [api, jobId, ready]);
+  useEffect(() => {
+    if (!blob) {setUrl(""); return;}
+    const value = URL.createObjectURL(blob); setUrl(value);
+    return () => URL.revokeObjectURL(value);
+  }, [blob]);
+
+  const submit = async () => {
+    if (!api || submitting.current || (job && !terminal(job))) return;
+    submitting.current = true; setBusy(true); setError("");
+    try {
+      const stored = localStorage.getItem(pendingKey);
+      const request: Request = stored ? JSON.parse(stored) : {id: crypto.randomUUID(), package_id: packageId, project_id: projectId};
+      if (request.project_id !== projectId) throw new Error("Вернитесь в проект с незавершённым запуском.");
+      localStorage.setItem(pendingKey, JSON.stringify(request));
+      const value = await api.submit(request);
+      localStorage.removeItem(pendingKey); setJob(value);
+      setRecent(items => [value, ...items.filter(item => item.id !== value.id)].slice(0, 20));
+    } catch (e) {setError(e instanceof Error ? e.message : "Не удалось запустить. Нажмите ещё раз — повторной задачи не будет.");}
+    finally {submitting.current = false; setBusy(false);}
+  };
+  const save = async () => {
+    if (!blob || !job || !window.openreel) return;
+    setBusy(true); setError("");
+    try {
+      const result = await window.openreel.fs.showSaveDialog({defaultPath: `Astel-${job.package_id}.mp4`, filters: [{name: "MP4", extensions: ["mp4"]}]});
+      if (result) {
+        const handle = await window.openreel.fs.openWrite(result);
+        try {
+          const size = 4 * 1024 * 1024;
+          for (let offset = 0; offset < blob.size; offset += size) {
+            await window.openreel.fs.writeChunk(handle, await blob.slice(offset, offset + size).arrayBuffer(), offset);
+          }
+          await window.openreel.fs.closeWrite(handle);
+        } catch (e) {await window.openreel.fs.abortWrite(handle); throw e;}
+      }
+    } catch {setError("Не удалось сохранить MP4.");}
+    finally {setBusy(false);}
+  };
+  const add = async () => {
+    if (!job || !blob) return;
+    setBusy(true); setError("");
+    try {await addStoryToTimeline(job, blob);}
+    catch (e) {setError(e instanceof Error ? e.message : "Не удалось добавить видео.");}
+    finally {setBusy(false);}
+  };
+  if (!api) return <p>Сборка доступна в OpenReel Astel для Mac.</p>;
+  return <section className="space-y-4 text-sm" aria-label="Сборка ролика">
+    <h3 className="font-bold">Сборка ролика</h3>
+    <p className="text-text-secondary">Озвучка, видеоряд, субтитры и 3D из подготовленного пакета → один MP4.</p>
+    <label className="block">Подготовленный пакет
+      <select aria-label="Подготовленный пакет" className="w-full bg-background-secondary border border-border rounded p-2 mt-1" value={packageId} disabled={busy || !!job && !terminal(job)} onChange={e => setPackageId(e.target.value)}>
+        {packages.map(item => <option key={item.id} value={item.id}>{item.name}</option>)}
+      </select>
+    </label>
+    <p className="text-xs text-text-secondary">{packages.find(item => item.id === packageId)?.description}</p>
+    <Button label={busy ? "Подождите…" : "Собрать MP4"} onClick={() => void submit()} disabled={busy || !packageId || !!job && !terminal(job)} />
+    <p className="text-xs text-text-secondary">Сборка идёт локально и продолжится после закрытия OpenReel. На Mac M1 3D может занять несколько минут.</p>
+    {recent.length > 0 && <label className="block">Сохранённые задачи
+      <select aria-label="Сохранённые задачи" value={job?.id ?? ""} className="w-full bg-background-secondary border border-border rounded p-2 mt-1" onChange={e => {const value = recent.find(item => item.id === e.target.value); if (value) setJob(value);}}>
+        <option value="" disabled>Выберите сохранённую задачу</option>
+        {recent.map(item => <option key={item.id} value={item.id}>{new Date(item.created_at).toLocaleString()} · {item.package_id} · {item.project_id === projectId ? "этот проект" : "другой проект"}</option>)}
+      </select>
+    </label>}
+    {job && <div className="space-y-2" aria-live="polite">
+      <p>{job.phase ?? job.status} · {Math.round(job.progress * 100)}%</p>
+      <progress aria-label="Прогресс сборки" value={job.progress} max={1} className="w-full" />
+      {!terminal(job) && <Button label="Остановить сборку" variant="ghost" onClick={() => void api.cancel(job.id).then(setJob).catch(() => setError("Не удалось остановить задачу; повторите."))} />}
+      {job.error && <p role="alert">{job.error}</p>}
+    </div>}
+    {url && <div className="space-y-3">
+      <video src={url} controls preload="metadata" className="w-full max-h-72 bg-black rounded" aria-label="Собранный ролик" />
+      <Button label="Сохранить MP4…" onClick={() => void save()} disabled={busy} />
+      <Button label={added ? "Добавлено на таймлайн" : "Добавить на таймлайн"} onClick={() => void add()} disabled={busy || added || job?.project_id !== projectId} />
+      <p className="text-xs text-text-secondary">На таймлайн добавится готовый ролик со звуком. Сцены и 3D внутри MP4 объединены.</p>
+    </div>}
+    {error && <p role="alert" className="text-red-400">{error}</p>}
+  </section>;
+};
