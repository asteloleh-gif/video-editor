+      <p className="text-xs text-text-secondary">{parent ? `Новая версия: ${parent.revision + 1}. ` : ""}Пустая строка разделяет сцены. Их длительность считается по реальной озвучке. Выбрано файлов: {selected.length}.</p>
+      <label className="block">Голос<select aria-label="Голос истории" className={control} value={profile} onChange={e => setProfile(e.target.value as typeof profile)}><option value="oleh-ru">Олег · русский / B</option><option value="oleh-en">Oleh · English</option></select></label>
+      <button className={button} disabled={busy || !title.trim() || !script.trim() || !selected.length} onClick={() => void run("story", {title, script, asset_ids: selected, profile, project_id: projectId, ...(parent ? {parent_story_id: parent.id, parent_digest: parent.digest} : {})})}>Собрать новый черновик</button>
+      <p className="text-xs text-text-secondary">Озвучка и сборка выполняются локально. Автоматические субтитры нужно проверить. Результат ожидает просмотра в Canvas.</p>
+    </div>}
+    {tab === "batch" && <div className="space-y-3">
+      <label className="block">Темы · одна на строку<textarea aria-label="Пакет тем" rows={9} className={control} value={topics} onChange={e => setTopics(e.target.value)} /></label>
+      <p className="text-xs text-text-secondary">До 100 тем. Получаем метаданные и сохраняем результаты; файлы выбираются отдельно.</p>
+      <button className={button} disabled={busy || !topics.trim()} onClick={() => void run("batch", {topics: topics.split("\n").map(s => s.trim()).filter(Boolean), providers: ["commons", "youtube"]})}>Запустить фоновый поиск</button>
+      {snapshot.searches.map(item => <button key={item.id} className={`${button} w-full text-left`} onClick={() => {setActiveSearch(item.id); setQuery(item.query); setTab("library");}}>{item.query} · {item.candidates.length} кандидатов</button>)}
+    </div>}
+    {tab === "review" && <div className="space-y-3">
+      <p>Готовые черновики для просмотра в Canvas.</p><button className={button} onClick={() => void api.openCanvas().catch(() => setError("Не удалось открыть Canvas на этом Mac."))}>Открыть Canvas на Mac</button><p className="text-xs text-text-secondary">В Canvas можно просмотреть ролик, сохранить замечание и передать тестовый черновик в Hub. Доступ к копии MP4 разрешается отдельно. Просмотр и принятие черновика не разрешают публикацию.</p>
+      {snapshot.stories.map(item => <button key={item.id} className={`${button} w-full text-left`} onClick={() => setStory(item)}>{item.title} · версия {item.revision} · {Math.round(item.duration)} с</button>)}
+      {story && <div className="space-y-2"><p>{story.title}</p><p className="text-xs">Ожидает согласования · {story.artifact_sha256.slice(0, 12)}</p>{url && <video src={url} controls preload="metadata" className="w-full max-h-72 bg-black" />}<button className={button} disabled={!blob || busy} onClick={() => void save()}>Сохранить MP4…</button><button className={button} disabled={!blob || busy || story.project_id !== projectId} onClick={() => void addStory()}>Добавить ролик на таймлайн</button><button className={button} disabled={busy} onClick={() => void exportCard()}>Экспорт карточки Canvas…</button><button className={button} onClick={() => {setParent(story); setTitle(story.title); setScript(story.script); setProfile(story.profile); setSelected(Array.from(new Set(story.scenes.map(scene => scene.asset_id)))); setTab("story");}}>Править сценарий / новая версия</button></div>}
+    </div>}
+    {snapshot.jobs.length > 0 && <div className="space-y-2 border-t border-border pt-3"><p className="font-semibold">Задания</p>{snapshot.jobs.slice(0, 6).map(job => <div key={job.id} className="space-y-1"><p className="text-xs">{job.phase} · {Math.round(job.progress * 100)}%</p>{job.error && <p className="text-xs text-red-400">{job.error}</p>}{!["ready", "failed", "cancelled"].includes(job.status) && <button className={button} onClick={() => void api.cancel(job.id).then(refresh).catch(() => setError("Не удалось остановить задачу."))}>Остановить</button>}</div>)}</div>}
