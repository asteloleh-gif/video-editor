+import { useEffect, useRef, useState } from "react";
+import type { VideoSearchItem, VideoSearchRequest } from "../../../types/global";
+
+const KEY = "astel.videoSearch.v1";
+const ID = /^[A-Za-z0-9_-]{11}$/;
+const button = "rounded border border-border px-2 py-2 text-xs hover:bg-white/10 disabled:opacity-40";
+const control = "mt-1 w-full rounded border border-border bg-panel p-2 text-fg";
+function items(value: unknown): VideoSearchItem[] {
+  if (!Array.isArray(value)) return [];
+  const seen = new Set<string>();
+  const result: VideoSearchItem[] = [];
+  for (const raw of value) {
+    if (!raw || typeof raw !== "object") continue;
+    const v = raw as Partial<VideoSearchItem>;
+    if (typeof v.id !== "string" || !ID.test(v.id) || typeof v.title !== "string" || seen.has(v.id)) continue;
+    seen.add(v.id);
+    result.push({
+      id: v.id, title: v.title.slice(0, 500), channel: typeof v.channel === "string" ? v.channel.slice(0, 200) : "Канал не указан",
+      url: `https://www.youtube.com/watch?v=${v.id}`, thumbnail: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`, live: v.live === true,
+      duration: typeof v.duration === "number" && Number.isFinite(v.duration) && v.duration >= 0 ? v.duration : null,
+      views: typeof v.views === "number" && Number.isFinite(v.views) && v.views >= 0 ? v.views : null,
+    });
+    if (result.length === 500) break;
+  }
+  return result;
+}
+function saved() {
+  try {
+    const value = JSON.parse(localStorage.getItem(KEY) || "{}");
+    return value && typeof value === "object" && !Array.isArray(value) ? value : {};
+  } catch { return {}; }
+}
+function duration(value: number | null): string {
+  if (value === null) return "Длительность не указана";
+  const s = Math.floor(value);
+  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
+}
+export function VideoSearchPanel() {
+  const api = window.openreel?.videoSearch;
+  const [initial] = useState(saved);
+  const [query, setQuery] = useState<string>(typeof initial.query === "string" ? initial.query : "");
+  const [limit, setLimit] = useState<VideoSearchRequest["limit"]>(25);
+  const [order, setOrder] = useState<VideoSearchRequest["order"]>("relevance");
+  const [results, setResults] = useState<VideoSearchItem[]>(() => items(initial.results));
+  const [selected, setSelected] = useState<VideoSearchItem[]>(() => items(initial.selected));
+  const [loadedQuery, setLoadedQuery] = useState<string>(typeof initial.loadedQuery === "string" ? initial.loadedQuery : "");
+  const [filter, setFilter] = useState("all");
+  const [showSelected, setShowSelected] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [message, setMessage] = useState("");
+  const requestId = useRef<string | null>(null);
+  const alive = useRef(true);
+  useEffect(() => {
+    alive.current = true;
+    return () => { alive.current = false; if (requestId.current) void api?.cancel(requestId.current).catch(() => {}); requestId.current = null; };
+  }, [api]);
+  useEffect(() => {
+    try { localStorage.setItem(KEY, JSON.stringify({ query, loadedQuery, results, selected })); } catch { setError("Подборка не сохранилась. Сохраните ссылки в файл."); }
+  }, [query, loadedQuery, results, selected]);
+  async function search() {
+    if (!api || requestId.current || !query.trim()) return;
+    const id = crypto.randomUUID();
+    requestId.current = id; setBusy(true); setError(""); setMessage(""); setShowSelected(false);
+    try {
+      const response = await api.query({ id, query: query.trim(), limit, order });
+      if (!alive.current || requestId.current !== id) return;
+      if (!response.ok) { if (response.code !== "cancelled") setError(response.message); return; }
+      setResults(items(response.results)); setLoadedQuery(response.query);
+      setMessage(response.from_cache ? "Недавний результат поиска" : "Поиск завершён");
+    } catch {
+      if (alive.current && requestId.current === id) setError("Поиск недоступен. Проверьте локальную установку и интернет.");
+    } finally {
+      if (alive.current && requestId.current === id) { requestId.current = null; setBusy(false); }
+    }
+  }
+  async function copy() {
+    try { await navigator.clipboard.writeText(selected.map(v => v.url).join("\n")); if (alive.current) setMessage("Ссылки скопированы"); }
+    catch { if (alive.current) setError("Не удалось скопировать. Используйте «Сохранить ссылки»."); }
+  }
+  function download() {
+    const blob = new Blob([selected.map(v => v.url).join("\n") + "\n"], { type: "text/plain;charset=utf-8" });
+    const url = URL.createObjectURL(blob);
+    const anchor = document.createElement("a"); anchor.href = url; anchor.download = "astel-video-links.txt"; anchor.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }
+  const source = showSelected ? selected : results;
+  const shown = source.filter(v => filter === "all" || (v.duration !== null && (filter === "short" ? v.duration < 240 : filter === "medium" ? v.duration >= 240 && v.duration < 1200 : v.duration >= 1200)));
+  return <section aria-label="Поиск видео" className="space-y-3 text-xs text-fg">
+    <div className="rounded border border-primary/30 p-2"><strong>Найти видео · YouTube</strong><p className="mt-1 text-fg-3">Без подписки и оплаты за поиск.</p></div>
+    <form onSubmit={e => { e.preventDefault(); void search(); }} className="space-y-2">
+      <label className="block">Тема<input aria-label="Тема поиска" className={control} value={query} maxLength={200} disabled={busy} placeholder="Например: GTA VI, интервью, путешествия…" onChange={e => setQuery(e.target.value)} /></label>
+      <label className="block">Сортировка<select aria-label="Сортировка поиска" className={control} value={order} disabled={busy} onChange={e => setOrder(e.target.value as VideoSearchRequest["order"])}><option value="relevance">По соответствию теме</option><option value="date">Сначала новые</option></select></label>
+      <label className="block">Количество<select aria-label="Количество результатов" className={control} value={limit} disabled={busy} onChange={e => setLimit(Number(e.target.value) as VideoSearchRequest["limit"])}>{[10, 25, 50, 100].map(n => <option value={n} key={n}>{n} роликов</option>)}</select></label>
+      <button type="submit" className={`${button} w-full bg-primary/20`} disabled={!api || !query.trim() || busy}>{busy ? "Ищу…" : "Найти видео"}</button>
+    </form>
+    {!api && <p role="alert">Откройте обновлённый OpenReel Astel для поиска.</p>}
+    {busy && <button className={button} onClick={() => { const id = requestId.current; requestId.current = null; setBusy(false); setMessage("Поиск остановлен"); if (id) void api?.cancel(id).catch(() => {}); }}>Остановить поиск</button>}
+    <div className="flex flex-wrap gap-2"><button className={button} aria-pressed={!showSelected} onClick={() => setShowSelected(false)}>Найдено · {results.length}</button><button className={button} aria-pressed={showSelected} onClick={() => setShowSelected(true)}>Подборка · {selected.length}</button></div>
+    <label className="block">Длительность<select aria-label="Фильтр длительности" className={control} value={filter} onChange={e => setFilter(e.target.value)}><option value="all">Любая</option><option value="short">До 4 минут</option><option value="medium">4–20 минут</option><option value="long">От 20 минут</option></select></label>
+    <p className="text-fg-3">Фильтр применяется к найденным роликам.</p>
+    {selected.length > 0 && <div className="flex flex-wrap gap-2"><button className={button} onClick={() => void copy()}>Копировать ссылки</button><button className={button} onClick={download}>Сохранить ссылки</button></div>}
+    {error && <p role="alert" className="text-red-400">{error}</p>}
+    {message && <p role="status" aria-live="polite">{message}</p>}
+    {!showSelected && loadedQuery && <p>«{loadedQuery}» · показано {shown.length} из {results.length}</p>}
+    {!busy && shown.length === 0 && <p className="text-fg-3">{showSelected ? "Подборка пока пуста. Отметьте подходящие ролики в результатах." : loadedQuery ? "Подходящих результатов нет. Уточните тему или измените фильтр." : "Введите тему, чтобы найти ролики."}</p>}
+    <div className="space-y-3">{shown.map(v => <article key={v.id} className="overflow-hidden rounded border border-border">
+      <a href={v.url} target="_blank" rel="noopener noreferrer" aria-label={`Смотреть: ${v.title}`}><img src={v.thumbnail} alt="" loading="lazy" referrerPolicy="no-referrer" crossOrigin="anonymous" className="aspect-video w-full object-cover" /></a>
+      <div className="space-y-2 p-2"><a href={v.url} target="_blank" rel="noopener noreferrer" className="block font-semibold hover:text-primary" title={v.title}>{v.title}</a><p className="text-fg-3">{v.channel}</p><p className="text-fg-3">{v.live ? "Эфир" : duration(v.duration)}{v.views !== null ? ` · ${new Intl.NumberFormat("ru-RU", { notation: "compact", maximumFractionDigits: 1 }).format(v.views)} просмотров` : ""}</p>
+      <label className="flex items-center gap-2"><input aria-label={`В подборку: ${v.title}`} type="checkbox" checked={selected.some(x => x.id === v.id)} onChange={e => setSelected(old => e.target.checked ? old.some(x => x.id === v.id) ? old : [...old, v].slice(0, 500) : old.filter(x => x.id !== v.id))} />В подборку</label></div>
+    </article>)}</div>
+  </section>;
+}
