@@ -0,0 +1,47 @@
+import { EventEmitter } from "node:events";
+import { PassThrough } from "node:stream";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { CHANNELS, videoSearchSchema } from "../../shared/ipc-contract";
+const mock = vi.hoisted(() => ({ handlers: new Map<string, Function>(), spawn: vi.fn() }));
+vi.mock("electron", () => ({ ipcMain: { handle: (name: string, fn: Function) => mock.handlers.set(name, fn) } }));
+vi.mock("node:child_process", () => ({ spawn: mock.spawn }));
+import { registerVideoSearchHandlers } from "./video-search";
+const request = { id: "12345678-1234-4234-8234-123456789abc", query: "street food", limit: 10, order: "relevance" };
+function sender(id: number) { return Object.assign(new EventEmitter(), { id }); }
+function child() { return Object.assign(new EventEmitter(), { stdout: new PassThrough(), stderr: new PassThrough(), stdin: new PassThrough(), kill: vi.fn() }); }
+beforeEach(() => { mock.spawn.mockReset(); mock.handlers.clear(); registerVideoSearchHandlers(); });
+describe("local video search", () => {
+  it.each([{ query: "" }, { query: "a\nb" }, { limit: 1000 }, { limit: true }, { order: "x" }, { path: "/private" }, { id: "../x" }])("rejects unsupported input before starting a process", bad => {
+    expect(videoSearchSchema.safeParse({ ...request, ...bad }).success).toBe(false);
+    expect(mock.handlers.get(CHANNELS.videoSearchQuery)!({ sender: sender(1) }, { ...request, ...bad }).ok).toBe(false);
+    expect(mock.spawn).not.toHaveBeenCalled();
+  });
+  it("uses a fixed program and JSON stdin without a shell; deduplicates an active request", async () => {
+    const process = child(); mock.spawn.mockReturnValue(process); const owner = sender(2);
+    const pending = mock.handlers.get(CHANNELS.videoSearchQuery)!({ sender: owner }, request);
+    expect(mock.handlers.get(CHANNELS.videoSearchQuery)!({ sender: owner }, request).code).toBe("busy");
+    expect(mock.spawn.mock.calls[0][0]).toMatch(/astel-video-search\/venv\/bin\/python$/);
+    expect(mock.spawn.mock.calls[0][1]).toEqual(["-m", "video_editor.video_search"]);
+    expect(mock.spawn.mock.calls[0][2].shell).toBeUndefined();
+    expect(process.stdin.read().toString()).toBe(JSON.stringify({ query: request.query, limit: 10, order: "relevance" }));
+    process.stdout.write(JSON.stringify({ ok: true, results: [] })); process.emit("close", 0);
+    expect(await pending).toEqual({ ok: true, results: [] });
+    expect(owner.listenerCount("destroyed")).toBe(0);
+  });
+  it("only the owning window and matching request can cancel", async () => {
+    const process = child(); mock.spawn.mockReturnValue(process); const owner = sender(3);
+    const pending = mock.handlers.get(CHANNELS.videoSearchQuery)!({ sender: owner }, request);
+    const cancel = mock.handlers.get(CHANNELS.videoSearchCancel)!;
+    cancel({ sender: sender(4) }, { id: request.id });
+    cancel({ sender: owner }, { id: "aaaaaaaa-1234-4234-8234-123456789abc" });
+    expect(process.kill).not.toHaveBeenCalled();
+    cancel({ sender: owner }, { id: request.id });
+    expect((await pending).code).toBe("cancelled"); expect(process.kill).toHaveBeenCalledOnce();
+  });
+  it("stops the process when its window closes", async () => {
+    const process = child(); mock.spawn.mockReturnValue(process); const owner = sender(5);
+    const pending = mock.handlers.get(CHANNELS.videoSearchQuery)!({ sender: owner }, request);
+    owner.emit("destroyed"); expect((await pending).code).toBe("cancelled");
+    expect(process.kill).toHaveBeenCalledOnce();
+  });
+});
diff --git a/apps/desktop/src/main/ipc/video-search.ts b/apps/desktop/src/main/ipc/video-search.ts
new file mode 100644
index 0000000..aba6dfe
--- /dev/null
+++ b/apps/desktop/src/main/ipc/video-search.ts
@@ -0,0 +1,54 @@
+import { ipcMain } from "electron";
+import { spawn } from "node:child_process";
+import path from "node:path";
+import os from "node:os";
+import { CHANNELS, videoSearchSchema, videoSearchCancelSchema } from "../../shared/ipc-contract";
+
+const root = path.join(os.homedir(), ".local/share/astel-video-search");
+const active = new Map<number, { id: string; cancel: () => void }>();
+const failure = (code: string, message: string) => ({ ok: false, code, message });
+
+export function registerVideoSearchHandlers(): void {
+  ipcMain.handle(CHANNELS.videoSearchQuery, (event, raw) => {
+    const parsed = videoSearchSchema.safeParse(raw);
+    if (!parsed.success) return failure("invalid_request", "Введите тему и параметры поиска.");
+    const owner = event.sender.id;
+    if (active.has(owner)) return failure("busy", "Дождитесь завершения текущего поиска.");
+    const { id, ...request } = parsed.data;
+    return new Promise(resolve => {
+      const child = spawn(path.join(root, "venv/bin/python"), ["-m", "video_editor.video_search"], {
+        env: { ...process.env, PYTHONPATH: path.join(root, "src") },
+        stdio: ["pipe", "pipe", "pipe"], windowsHide: true,
+      });
+      let output = "";
+      let settled = false;
+      const finish = (result: unknown) => {
+        if (settled) return;
+        settled = true; clearTimeout(timer);
+        event.sender.removeListener("destroyed", cancel);
+        if (active.get(owner)?.id === id) active.delete(owner);
+        resolve(result);
+      };
+      const cancel = () => { child.kill(); finish(failure("cancelled", "Поиск остановлен.")); };
+      const timer = setTimeout(() => { child.kill(); finish(failure("timeout", "Поиск занял слишком долго. Повторите с меньшим количеством результатов.")); }, 60_000);
+      active.set(owner, { id, cancel });
+      event.sender.once("destroyed", cancel);
+      child.stdout.on("data", (chunk: Buffer) => {
+        output += chunk.toString();
+        if (output.length > 1_000_000) { child.kill(); finish(failure("invalid_response", "Слишком большой ответ поиска.")); }
+      });
+      child.stderr.resume();
+      child.stdin.on("error", () => {});
+      child.on("error", () => finish(failure("not_installed", "Локальный модуль поиска не установлен.")));
+      child.on("close", code => {
+        if (code !== 0) return finish(failure("unavailable", "YouTube не ответил. Проверьте интернет и повторите позже."));
+        try { finish(JSON.parse(output)); } catch { finish(failure("invalid_response", "Не удалось прочитать результаты поиска.")); }
+      });
+      child.stdin.end(JSON.stringify(request));
+    });
+  });
+  ipcMain.handle(CHANNELS.videoSearchCancel, (event, raw) => {
+    const parsed = videoSearchCancelSchema.safeParse(raw);
+    if (parsed.success && active.get(event.sender.id)?.id === parsed.data.id) active.get(event.sender.id)?.cancel();
+  });
+}
