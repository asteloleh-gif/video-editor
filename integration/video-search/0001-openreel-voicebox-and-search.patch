+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { VoiceboxBridge, VoiceboxJob, VoiceboxRequest } from "../../../types/global";
+import { VoiceboxPanel } from "./VoiceboxPanel";
+const state = vi.hoisted(() => ({ project: { id: "project-a" } }));
+const add = vi.hoisted(() => vi.fn());
+vi.mock("../../../stores/project-store", () => ({ useProjectStore: (selector: (s: typeof state) => unknown) => selector(state) }));
+vi.mock("./voicebox-timeline", () => ({ addVoiceboxToTimeline: add }));
+let api: VoiceboxBridge;
+const ready: VoiceboxJob = { id: "12345678-1234-4234-8234-123456789abc", profile: "oleh-ru", text: "Привет!", speed: 1, warm: true, project_id: "project-a", status: "ready", duration: 2 };
+beforeEach(() => {
+  localStorage.clear(); state.project.id = "project-a"; add.mockReset().mockResolvedValue(undefined);
+  URL.createObjectURL = vi.fn(() => "blob:voice"); URL.revokeObjectURL = vi.fn();
+  api = {
+    profiles: vi.fn().mockResolvedValue([{ id: "oleh-ru", name: "Олег — русский", language: "ru", warm: true, speed: 1 }, { id: "oleh-en", name: "Oleh — English", language: "en", warm: false, speed: 1.02 }]),
+    submit: vi.fn(async (req: VoiceboxRequest) => ({ ...req, status: "queued" as const })),
+    status: vi.fn().mockResolvedValue(ready), resume: vi.fn().mockResolvedValue(ready),
+    cancel: vi.fn(), audio: vi.fn().mockResolvedValue(new ArrayBuffer(12)),
+  };
+  Object.defineProperty(window, "openreel", { value: { voicebox: api }, configurable: true });
+});
+afterEach(cleanup);
+describe("local speech workflow", () => {
+  it("generates exact text without a cloud key, previews and adds to timeline", async () => {
+    render(<VoiceboxPanel />);
+    await screen.findByRole("option", { name: "Олег — русский" });
+    fireEvent.change(screen.getByLabelText("Текст для озвучки"), { target: { value: "Привет!" } });
+    fireEvent.click(screen.getByRole("button", { name: "Озвучить" }));
+    await screen.findByLabelText("Прослушать озвучку");
+    expect(api.submit).toHaveBeenCalledOnce();
+    expect(api.submit).toHaveBeenCalledWith(expect.objectContaining({ text: "Привет!", profile: "oleh-ru", project_id: "project-a", warm: true }));
+    fireEvent.click(screen.getByRole("button", { name: "Добавить на таймлайн" }));
+    await waitFor(() => expect(add).toHaveBeenCalledOnce());
+    expect(screen.getByRole("link", { name: "Скачать WAV" })).toHaveAttribute("download");
+  });
+  it("restores an existing job after tab remount without generating again", async () => {
+    localStorage.setItem("astel.voicebox.v1", JSON.stringify(ready));
+    const first = render(<VoiceboxPanel />);
+    await screen.findByLabelText("Прослушать озвучку");
+    first.unmount();
+    render(<VoiceboxPanel />);
+    await screen.findByLabelText("Прослушать озвучку");
+    expect(api.resume).toHaveBeenCalledTimes(2);
+    expect(api.submit).not.toHaveBeenCalled();
+    expect(api.cancel).not.toHaveBeenCalled();
+    expect(URL.revokeObjectURL).toHaveBeenCalled();
+  });
+  it("prevents adding to a different project", async () => {
+    localStorage.setItem("astel.voicebox.v1", JSON.stringify(ready));
+    state.project.id = "project-b";
+    render(<VoiceboxPanel />);
+    await screen.findByLabelText("Прослушать озвучку");
+    expect(screen.getByRole("button", { name: "Добавить на таймлайн" })).toBeDisabled();
+    expect(add).not.toHaveBeenCalled();
+  });
+  it("uses the English reference and accepted long-form tempo", async () => {
+    render(<VoiceboxPanel />);
+    await screen.findByRole("option", { name: "Oleh — English" });
+    fireEvent.change(screen.getByLabelText("Голос"), { target: { value: "oleh-en" } });
+    fireEvent.change(screen.getByLabelText("Текст для озвучки"), { target: { value: "Hello, my friend!" } });
+    fireEvent.click(screen.getByRole("button", { name: "Озвучить" }));
+    await waitFor(() => expect(api.submit).toHaveBeenCalledWith(expect.objectContaining({ profile: "oleh-en", speed: 1.02, warm: false })));
+  });
+  it("can reconnect an uncertain submission using the same saved request", async () => {
