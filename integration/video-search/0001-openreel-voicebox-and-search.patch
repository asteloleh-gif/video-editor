+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { VideoSearchPanel } from "./VideoSearchPanel";
+const row = { id: "QdBZY2fkU-0", title: "Test video", channel: "Test channel", duration: 90, views: 100, live: false, url: "javascript:ignored", thumbnail: "file:///ignored" };
+const query = vi.fn(); const cancel = vi.fn().mockResolvedValue(undefined);
+beforeEach(() => { localStorage.clear(); query.mockReset(); cancel.mockClear(); window.openreel = { videoSearch: { query, cancel } } as any; });
+afterEach(() => { cleanup(); delete window.openreel; });
+it("recovers corrupt saved state and preserves selected canonical links on remount", async () => {
+  localStorage.setItem("astel.videoSearch.v1", "null");
+  query.mockResolvedValue({ ok: true, query: "food", results: [row], from_cache: false });
+  const view = render(<VideoSearchPanel />);
+  fireEvent.change(screen.getByLabelText("Тема поиска"), { target: { value: "food" } });
+  fireEvent.click(screen.getByRole("button", { name: "Найти видео" }));
+  await screen.findByText("Test video");
+  expect(screen.getByRole("link", { name: "Test video" }).getAttribute("href")).toBe("https://www.youtube.com/watch?v=QdBZY2fkU-0");
+  fireEvent.click(screen.getByLabelText("В подборку: Test video"));
+  view.unmount(); render(<VideoSearchPanel />);
+  fireEvent.click(screen.getByRole("button", { name: "Подборка · 1" }));
+  expect(screen.getByLabelText("В подборку: Test video")).toBeChecked();
+  fireEvent.change(screen.getByLabelText("Фильтр длительности"), { target: { value: "long" } });
+  expect(screen.queryByText("Test video")).toBeNull();
+});
+it("cancels on panel close and ignores the late response", async () => {
+  let finish!: Function;
+  query.mockImplementation(() => new Promise(resolve => { finish = resolve; }));
