+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { VoiceboxJob } from "../../../types/global";
+import { addVoiceboxToTimeline } from "./voicebox-timeline";
+const mock = vi.hoisted(() => ({ state: {} as any, set: vi.fn(), scratch: {} as any }));
+vi.mock("../../../stores/project-store", () => ({ useProjectStore: { getState: () => mock.state, setState: mock.set } }));
+vi.mock("@openreel/core", () => ({ ActionExecutor: class {
+  execute = (...args: unknown[]) => mock.scratch.execute(...args);
+  getHistory = () => ({ getHistoryEntries: () => [] });
+} }));
+const job: VoiceboxJob = { id: "job-1", project_id: "a", profile: "oleh-ru", text: "Привет", speed: 1, warm: true, status: "ready" };
+beforeEach(() => {
+  mock.set.mockReset();
+  mock.scratch = { execute: vi.fn().mockResolvedValue({ success: true }) };
+  mock.state = {
+    project: { id: "a", mediaLibrary: { items: [] }, timeline: { tracks: [{ id: "video", clips: [{ startTime: 3, duration: 4 }] }] } },
+    importMedia: vi.fn().mockResolvedValue({ success: true, actionId: "media-1" }),
+    actionExecutor: { getHistory: vi.fn(() => ({ beginGroup: vi.fn(), endGroup: vi.fn(), push: vi.fn() })) },
+  };
+});
+describe("speech timeline import", () => {
+  it("imports a WAV, creates an audio track and appends after existing clips", async () => {
+    await addVoiceboxToTimeline(job, new Blob(["wav"]));
+    expect(mock.state.importMedia).toHaveBeenCalledOnce();
+    expect(mock.scratch.execute).toHaveBeenNthCalledWith(2, expect.objectContaining({ type: "clip/add", params: expect.objectContaining({ mediaId: "media-1", startTime: 7 }) }), expect.anything());
+    expect(mock.set).toHaveBeenCalledOnce();
+  });
+  it("refuses a wrong project before importing", async () => {
+    mock.state.project.id = "b";
+    await expect(addVoiceboxToTimeline(job, new Blob())).rejects.toThrow("Откройте проект");
+    expect(mock.state.importMedia).not.toHaveBeenCalled();
+  });
+  it("refuses a project switch during decoding", async () => {
+    mock.state.importMedia.mockImplementation(async () => {
+      mock.state.project = { ...mock.state.project, id: "b" };
+      return { success: true, actionId: "media-1" };
+    });
+    await expect(addVoiceboxToTimeline(job, new Blob())).rejects.toThrow("Откройте проект");
+    expect(mock.scratch.execute).not.toHaveBeenCalled();
+    expect(mock.set).not.toHaveBeenCalled();
+    expect(mock.state.actionExecutor.getHistory).not.toHaveBeenCalled();
+  });
+  it("refuses to overwrite manual edits made during track creation", async () => {
+    mock.scratch.execute.mockImplementation(async () => {
+      mock.state.project = { ...mock.state.project, modifiedAt: 123 };
+      return { success: true };
+    });
+    await expect(addVoiceboxToTimeline(job, new Blob())).rejects.toThrow("Проект изменился");
+    expect(mock.set).not.toHaveBeenCalled();
+    expect(mock.state.actionExecutor.getHistory).not.toHaveBeenCalled();
+  });
+  it("reuses the same imported media on another add", async () => {
+    mock.state.project.mediaLibrary.items = [{ id: "media-existing", name: "Voicebox-oleh-ru-job-1.wav" }];
+    await addVoiceboxToTimeline(job, new Blob());
+    expect(mock.state.importMedia).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/web/src/components/editor/inspector/voicebox-timeline.ts b/apps/web/src/components/editor/inspector/voicebox-timeline.ts
new file mode 100644
index 0000000..fa7d131
--- /dev/null
+++ b/apps/web/src/components/editor/inspector/voicebox-timeline.ts
@@ -0,0 +1,40 @@
+import { v4 as uuid } from "uuid";
+import { ActionExecutor } from "@openreel/core";
+import type { VoiceboxJob } from "../../../types/global";
+import { useProjectStore } from "../../../stores/project-store";
+import { cloneProjectForEdit } from "../../../stores/project/clone-project-for-edit";
+
+export async function addVoiceboxToTimeline(job: VoiceboxJob, blob: Blob): Promise<void> {
+  const store = useProjectStore;
+  const check = () => {
+    if (store.getState().project.id !== job.project_id) throw new Error("Откройте проект, в котором была создана озвучка.");
+  };
+  check();
+  if (job.status !== "ready") throw new Error("Озвучка ещё не готова.");
+  const fileName = `Voicebox-${job.profile}-${job.id}.wav`;
+  let mediaId = store.getState().project.mediaLibrary.items.find(m => m.name === fileName)?.id;
+  if (!mediaId) {
+    const result = await store.getState().importMedia(new File([blob], fileName, { type: "audio/wav" }));
+    check();
+    if (!result.success || !result.actionId) throw new Error("Не удалось импортировать WAV. Скачайте файл и попробуйте снова.");
+    mediaId = result.actionId;
+  }
+  const { project, actionExecutor } = store.getState();
+  const copy = cloneProjectForEdit(project);
+  const scratch = new ActionExecutor();
+  const trackId = uuid();
+  const startTime = Math.max(0, ...copy.timeline.tracks.flatMap(t => t.clips.map(c => c.startTime + c.duration)));
+  // Work on a copy; refuse to overwrite a project changed during async actions.
+  const track = await scratch.execute({ type: "track/add", id: uuid(), timestamp: Date.now(), params: { trackType: "audio", trackId } }, copy);
+  if (!track.success) throw new Error("Не удалось создать аудиодорожку.");
+  const clip = await scratch.execute({ type: "clip/add", id: uuid(), timestamp: Date.now(), params: { trackId, mediaId, startTime } }, copy);
+  check();
+  if (store.getState().project !== project) throw new Error("Проект изменился. Озвучка сохранена в медиа; нажмите добавить ещё раз.");
+  if (!clip.success) throw new Error("Не удалось добавить аудиоклип.");
+  const history = actionExecutor.getHistory();
+  history.beginGroup("Add Voicebox narration");
+  try {
+    for (const entry of scratch.getHistory().getHistoryEntries()) history.push(entry.action, entry.inverseAction);
+  } finally { history.endGroup(); }
+  store.setState({ project: { ...copy, modifiedAt: Date.now() } });
+}
