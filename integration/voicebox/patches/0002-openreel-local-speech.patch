+  it("uses the English reference and accepted long-form tempo", async () => {
+    render(<VoiceboxPanel />);
+    await screen.findByRole("option", { name: "Oleh — English" });
+    fireEvent.change(screen.getByLabelText("Голос"), { target: { value: "oleh-en" } });
