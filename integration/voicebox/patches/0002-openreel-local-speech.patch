+import { VoiceboxPanel } from "./VoiceboxPanel";
+const state = vi.hoisted(() => ({ project: { id: "project-a" } }));
+const add = vi.hoisted(() => vi.fn());
+vi.mock("../../../stores/project-store", () => ({ useProjectStore: (selector: (s: typeof state) => unknown) => selector(state) }));
+vi.mock("./voicebox-timeline", () => ({ addVoiceboxToTimeline: add }));
+let api: VoiceboxBridge;
+const ready: VoiceboxJob = { id: "12345678-1234-4234-8234-123456789abc", profile: "oleh-ru", text: "Привет!", speed: 1, warm: true, project_id: "project-a", status: "ready", duration: 2 };
+beforeEach(() => {
+  localStorage.clear(); state.project.id = "project-a"; add.mockReset().mockResolvedValue(undefined);
+  URL.createObjectURL = vi.fn(() => "blob:voice"); URL.revokeObjectURL = vi.fn();
+  api = {
+    profiles: vi.fn().mockResolvedValue([{ id: "oleh-ru", name: "Олег — русский", language: "ru", warm: true, speed: 1 }, { id: "oleh-en", name: "Oleh — English", language: "en", warm: false, speed: 1.02 }]),
+    submit: vi.fn(async (req: VoiceboxRequest) => ({ ...req, status: "queued" as const })),
+    status: vi.fn().mockResolvedValue(ready), resume: vi.fn().mockResolvedValue(ready),
+    cancel: vi.fn(), audio: vi.fn().mockResolvedValue(new ArrayBuffer(12)),
