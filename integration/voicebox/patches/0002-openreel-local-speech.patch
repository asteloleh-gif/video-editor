+afterEach(cleanup);
+describe("local speech workflow", () => {
+  it("generates exact text without a cloud key, previews and adds to timeline", async () => {
+    render(<VoiceboxPanel />);
+    await screen.findByRole("option", { name: "Олег — русский" });
+    fireEvent.change(screen.getByLabelText("Текст для озвучки"), { target: { value: "Привет!" } });
+    fireEvent.click(screen.getByRole("button", { name: "Озвучить" }));
+    await screen.findByLabelText("Прослушать озвучку");
+    expect(api.submit).toHaveBeenCalledOnce();
+    expect(api.submit).toHaveBeenCalledWith(expect.objectContaining({ text: "Привет!", profile: "oleh-ru", project_id: "project-a", warm: true }));
+    fireEvent.click(screen.getByRole("button", { name: "Добавить на таймлайн" }));
+    await waitFor(() => expect(add).toHaveBeenCalledOnce());
+    expect(screen.getByRole("link", { name: "Скачать WAV" })).toHaveAttribute("download");
+  });
+  it("restores an existing job after tab remount without generating again", async () => {
+    localStorage.setItem("astel.voicebox.v1", JSON.stringify(ready));
+    const first = render(<VoiceboxPanel />);
+    await screen.findByLabelText("Прослушать озвучку");
+    first.unmount();
+    render(<VoiceboxPanel />);
+    await screen.findByLabelText("Прослушать озвучку");
+    expect(api.resume).toHaveBeenCalledTimes(2);
+    expect(api.submit).not.toHaveBeenCalled();
+    expect(api.cancel).not.toHaveBeenCalled();
+    expect(URL.revokeObjectURL).toHaveBeenCalled();
+  });
+  it("prevents adding to a different project", async () => {
